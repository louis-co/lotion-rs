{
    "productName": "lotion-rs",
    "version": "0.2.4",
    "identifier": "io.lotion-rs.secure.v2",
    "build": {
        "frontendDist": "assets"
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/diegoakanotoperator/lotion-rs/releases/latest/download/latest.json"
            ],
            "dialog": true,
            "pubkey": "RWQpCdih9OnWkf2sTicrpau6XAB8D8xKOqoMNnTcbAZfJ14SN5bCFkl/"
        }
    },
    "app": {
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
        },
        "windows": [
            {
                "label": "main",
                "create": false,
                "url": "index.html",
                "title": "Notion",
                "width": 1320,
                "height": 860,
                "minWidth": 640,
                "minHeight": 480,
                "visible": false,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "trafficLightPosition": {
                    "x": 14,
                    "y": 20.5
                }
            }
        ]
    },
    "bundle": {
        "active": true,
        "targets": [
            "deb",
            "rpm",
            "appimage",
            "dmg",
            "nsis"
        ],
        "icon": [
            "assets/icon.png",
            "assets/icon.ico",
            "assets/icon.icns"
        ],
        "category": "Productivity",
        "shortDescription": "Native Rust client for Notion.so",
        "longDescription": "lotion-rs is a native Rust desktop client for Notion.so, built with Tauri v2. Features Zero-Trust security, LiteBox sandboxing, and custom theming.",
        "resources": [
            "assets/*",
            "i18n/**/*"
        ],
        "macOS": {
            "minimumSystemVersion": "12.0"
        }
    }
}